FROM python:3.11.6-slim-bookworm AS base
# Install system dependencies for psycopg2 and other packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    curl \
    libgl1 \
    libglib2.0-0 \
    libnss3 \   
    libnspr4 \ 
    libdbus-1-3 \     
    libatk1.0-0 \ 
    libatk-bridge2.0-0 \     
    libcups2 \         
    libxkbcommon0 \          
    libatspi2.0-0 \ 
    libxcomposite1 \                      
    libxdamage1 \       
    libxrandr2 \     
    libgbm1 \ 
    libpango-1.0-0 \  
    libcairo2 \     
    libasound2 \ 
    zlib1g-dev \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN pip install pipx
RUN python3 -m pipx ensurepath
RUN pipx install poetry==1.8.3
# Install huggingface_hub for authentication
RUN pip install --no-cache-dir huggingface_hub
ENV PATH="/root/.local/bin:$PATH"
ENV PATH=".venv/bin/:$PATH"
# https://python-poetry.org/docs/configuration/#virtualenvsin-project
ENV POETRY_VIRTUALENVS_IN_PROJECT=true
ENV POETRY_HTTP_TIMEOUT=600

FROM base AS dependencies
WORKDIR /app
COPY pyproject.toml poetry.lock ./
ARG POETRY_EXTRAS="vector-stores-qdrant embeddings-huggingface llms-gemini embeddings-gemini storage-nodestore-postgres"
RUN poetry install --no-root --extras "${POETRY_EXTRAS}"
RUN playwright install 
FROM base AS app
# Add ARG for Hugging Face token - can be passed at build time
# ARG HF_TOKEN="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"
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV APP_ENV=prod
ENV PYTHONPATH="$PYTHONPATH:/app/private_gpt/"
EXPOSE 8000
WORKDIR /app

# Create directories
RUN mkdir -p local_data models static

# Copy dependencies
COPY --from=dependencies /app/.venv/ .venv

# Copy configuration and metadata files
COPY pyproject.toml poetry.lock alembic.ini version.txt Makefile *.yaml /app/

# Copy application directories
COPY private_gpt/ /app/private_gpt/
COPY scripts/ /app/scripts/
COPY alembic/ /app/alembic/

# Create startup script with Hugging Face login
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Login to Hugging Face if token is provided\n\
if [ -n "$HF_TOKEN" ]; then\n\
  echo "Logging into Hugging Face..."\n\
  python -c "from huggingface_hub import login; login(token=\"$HF_TOKEN\", write_permission=True)"\n\
  echo "Hugging Face login successful"\n\
else\n\
  echo "No Hugging Face token provided, skipping login"\n\
fi\n\
\n\
# Apply Alembic database migrations\n\
echo "Applying database migrations in sequence"\n\
alembic upgrade 0c3bba0d99f7\n\
alembic upgrade d06186f6137d\n\
alembic upgrade b3579174f52d\n\
alembic upgrade 4aae9ee1ebd1\n\
alembic upgrade 93338be47304\n\
alembic upgrade aa67a3d40eb8\n\
alembic upgrade 4ab215adb170\n\
alembic upgrade efd1005423e3\n\
alembic upgrade bd924bd5f7c7\n\
alembic upgrade 402b01ec4e0c\n\
alembic upgrade ad321d227e01\n\
alembic upgrade b27038ed57a8\n\
alembic upgrade 74c21a6df740\n\
alembic upgrade 8cd9ac60d165\n\
alembic upgrade cbb350a4679c\n\
alembic upgrade head\n\
\n\
# Load fixture data\n\
echo "Loading fixtures"\n\
poetry run python scripts/fixtures.py\n\
playwright install \n\
\n\
# Fix for tiktoken download issues\n\
if [ -n "$TIKTOKEN_CACHE_DIR" ]; then\n\
  mkdir -p "$TIKTOKEN_CACHE_DIR"\n\
  TIKTOKEN_URL="https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken"\n\
  CACHE_FILE="$TIKTOKEN_CACHE_DIR/9b5ad71b4cead37050684f88e"\n\
  if [ ! -f "$CACHE_FILE" ]; then\n\
    echo "Pre-downloading tiktoken encoding..."\n\
    curl -L --retry 5 "$TIKTOKEN_URL" -o "$CACHE_FILE" || echo "Warning: Failed to pre-download tiktoken"\n\
  fi\n\
fi\n\
\n\
# Pre-download fastembed sparse model to bypass runtime network issues\n\
echo \"Ensuring fastembed sparse model is present...\"\n\
mkdir -p /app/models/cache/fastembed\n\
huggingface-cli download prithivida/Splade_PP_en_v1 --cache-dir /app/models/cache/fastembed || echo \"Warning: Failed to pre-download fastembed model\"\n\
\n\
echo "Starting FastAPI server with profile: gemini"\n\
PYTHONUNBUFFERED=1 PGPT_PROFILES=gemini poetry run python -m uvicorn private_gpt.main:app --host 0.0.0.0 --port 8000 --workers 2' > /app/startup.sh && chmod +x /app/startup.sh
ENTRYPOINT ["/app/startup.sh"]
